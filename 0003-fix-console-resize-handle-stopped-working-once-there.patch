From e9fd988c1b489c2aa61c51bf7aae908bad71ae19 Mon Sep 17 00:00:00 2001
Date: Tue, 28 Jul 2026 15:49:16 -0000
Subject: fix(console): resize handle stopped working once there was output

---
 src/css/components/console.css | 27 +++++++++++++++++--
 src/index.html                 |  1 +
 src/js/ui/console.js           | 47 +++++++++++++++++++++++++++++-----
 3 files changed, 66 insertions(+), 9 deletions(-)

diff --git a/src/css/components/console.css b/src/css/components/console.css
index 864f60e..aa7addd 100644
--- a/src/css/components/console.css
+++ b/src/css/components/console.css
@@ -17,10 +17,31 @@
     display: flex;
     flex-direction: column;
     z-index: 999;
-    /* resize necesita un overflow distinto de visible para dibujar el agarre. */
-    resize: both;
     overflow: hidden;
 }
+
+/* Agarre propio en vez de `resize: both`. El agarre nativo se dibuja en la
+   esquina inferior derecha del panel, justo donde queda el <pre> con su barra
+   de scroll: apenas la consola tenía texto, el hijo se comía el pointerdown y
+   no se podía redimensionar. Este va por encima de todo. */
+.console-resize-handle {
+    position: absolute;
+    right: 0;
+    bottom: 0;
+    width: 18px;
+    height: 18px;
+    z-index: 3;
+    cursor: nwse-resize;
+    background: repeating-linear-gradient(135deg,
+            transparent 0 3px,
+            rgba(192, 132, 252, 0.55) 3px 4px);
+    border-bottom-right-radius: 8px;
+}
+.console-resize-handle:hover {
+    background: repeating-linear-gradient(135deg,
+            transparent 0 3px,
+            var(--primary-glow) 3px 4px);
+}
 .console-header {
     display: flex;
     justify-content: space-between;
@@ -76,4 +97,6 @@
     color: var(--text-dim);
     white-space: pre-wrap;
     word-break: break-all;
+    /* Deja libre la esquina del agarre para que no tape la última línea. */
+    padding-bottom: 20px;
 }
diff --git a/src/index.html b/src/index.html
index c6ae13c..ff3174b 100644
--- a/src/index.html
+++ b/src/index.html
@@ -242,6 +242,7 @@
             </div>
         </div>
         <pre id="console-output" class="console-output"></pre>
+        <div id="console-resize-handle" class="console-resize-handle" title="Redimensionar"></div>
     </div>
 
     <script type="module" src="js/core/main.js"></script>
diff --git a/src/js/ui/console.js b/src/js/ui/console.js
index 5de0b23..82dc155 100644
--- a/src/js/ui/console.js
+++ b/src/js/ui/console.js
@@ -8,6 +8,8 @@ const MAX_LINES = 2000;
 // preferencia de ventana, no configuración del launcher, y se escribe seguido.
 const GEOMETRY_KEY = 'lumineria.console.geometry';
 const DEFAULT_SIZE = { width: 480, height: 320 };
+// Tiene que coincidir con min-width/min-height de .console-panel en el CSS.
+const MIN_SIZE = { width: 300, height: 160 };
 const MARGIN = 16;
 // Cuánto del panel hay que dejar siempre visible para poder volver a agarrarlo.
 const MIN_VISIBLE = 80;
@@ -75,8 +77,8 @@ function saveGeometry() {
     }
 }
 
-// Las escrituras se agrupan por frame: el ResizeObserver dispara en cada píxel
-// que se arrastra el agarre.
+// Agrupa las escrituras por frame, para no pegarle a localStorage en cada
+// evento cuando la ventana se redimensiona de forma continua.
 function queueSaveGeometry() {
     if (saveQueued) return;
     saveQueued = true;
@@ -157,11 +159,42 @@ function initDragAndResize() {
         header.addEventListener('pointercancel', onUp);
     });
 
-    // El agarre de resize es nativo (CSS resize: both), así que no hay eventos
-    // propios: se observa el tamaño y se guarda.
-    new ResizeObserver(() => {
-        if (isPanelOpen) queueSaveGeometry();
-    }).observe(panel);
+    const handle = panel.querySelector('.console-resize-handle');
+
+    handle?.addEventListener('pointerdown', (e) => {
+        if (e.button !== 0) return;
+        // Sin esto el pointerdown sigue viaje al <pre> y arranca una selección
+        // de texto que pelea con el arrastre.
+        e.preventDefault();
+        e.stopPropagation();
+
+        const startX = e.clientX;
+        const startY = e.clientY;
+        const startWidth = panel.offsetWidth;
+        const startHeight = panel.offsetHeight;
+        panel.classList.add('dragging');
+        handle.setPointerCapture(e.pointerId);
+
+        const onMove = (ev) => {
+            const maxWidth = window.innerWidth - panel.offsetLeft - MARGIN;
+            const maxHeight = window.innerHeight - panel.offsetTop - MARGIN;
+            const width = startWidth + ev.clientX - startX;
+            const height = startHeight + ev.clientY - startY;
+            panel.style.width = `${Math.min(Math.max(width, MIN_SIZE.width), maxWidth)}px`;
+            panel.style.height = `${Math.min(Math.max(height, MIN_SIZE.height), maxHeight)}px`;
+        };
+        const onUp = () => {
+            handle.removeEventListener('pointermove', onMove);
+            handle.removeEventListener('pointerup', onUp);
+            handle.removeEventListener('pointercancel', onUp);
+            panel.classList.remove('dragging');
+            saveGeometry();
+        };
+
+        handle.addEventListener('pointermove', onMove);
+        handle.addEventListener('pointerup', onUp);
+        handle.addEventListener('pointercancel', onUp);
+    });
 
     window.addEventListener('resize', () => {
         if (!isPanelOpen) return;
-- 
2.55.0

