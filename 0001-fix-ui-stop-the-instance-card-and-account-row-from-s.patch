From 5cea0249858f09982eafc19b6f388d6aada4cd55 Mon Sep 17 00:00:00 2001
Date: Tue, 28 Jul 2026 15:25:00 -0000
Subject: fix(ui): stop the instance card and account row from stretching

---
 src/css/components/cards.css   |  4 ++++
 src/css/components/sidebar.css | 20 ++++++++++++++++++--
 src/js/features/auth/auth.js   |  9 ++++++++-
 3 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/src/css/components/cards.css b/src/css/components/cards.css
index 9f318d2..363bfa2 100644
--- a/src/css/components/cards.css
+++ b/src/css/components/cards.css
@@ -1,6 +1,10 @@
 .profiles-grid {
     display: grid;
     grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
+    /* La grilla ocupa toda la altura por el flex:1 de abajo. Sin esto las filas
+       se estiran para repartirse ese alto, y con una sola instancia la tarjeta
+       queda del porte de la ventana. */
+    align-content: start;
     gap: 20px;
     width: 100%;
     max-width: 100%;
diff --git a/src/css/components/sidebar.css b/src/css/components/sidebar.css
index 03cae60..97131a3 100644
--- a/src/css/components/sidebar.css
+++ b/src/css/components/sidebar.css
@@ -21,8 +21,7 @@
     font-size: 0.9rem; transition: 0.25s ease;
 }
 .account-btn:hover { background: rgba(255, 255, 255, 0.08); border-color: var(--primary-glow); }
-.account-avatar { font-size: 1.1rem; }
-#account-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.account-avatar { font-size: 1.1rem; flex-shrink: 0; }
 
 .account-row {
     display: flex;
@@ -32,6 +31,9 @@
 
 .account-row #login-btn {
     flex: 1;
+    /* Sin esto el ancho mínimo del texto empuja al botón de salir fuera de la
+       barra: los items flex no bajan de su contenido salvo que se les permita. */
+    min-width: 0;
 }
 
 .account-label-group {
@@ -39,6 +41,18 @@
     flex-direction: column;
     align-items: flex-start;
     line-height: 1.15;
+    min-width: 0;
+    max-width: 100%;
+}
+
+/* Nombre y estado en una sola línea cada uno: si el nombre es largo o la cuenta
+   es premium, el texto se recorta en vez de agrandar la fila a dos renglones. */
+#account-label,
+.account-sublabel {
+    max-width: 100%;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
 }
 
 .account-sublabel {
@@ -51,4 +65,6 @@
     width: 44px;
     padding: 0;
     justify-content: center;
+    font-size: 1.1rem;
+    line-height: 1;
 }
\ No newline at end of file
diff --git a/src/js/features/auth/auth.js b/src/js/features/auth/auth.js
index 6c70e97..dddfd88 100644
--- a/src/js/features/auth/auth.js
+++ b/src/js/features/auth/auth.js
@@ -58,6 +58,10 @@ function tipoDeCuenta(session) {
     return session.ownsMinecraft ? 'premium' : 'sin licencia';
 }
 
+function capitalizar(texto) {
+    return texto.charAt(0).toUpperCase() + texto.slice(1);
+}
+
 function avatarDeCuenta(session) {
     if (session.userType !== 'msa') return '👤';
     return session.ownsMinecraft ? '👑' : '⚠️';
@@ -67,7 +71,10 @@ function avatarDeCuenta(session) {
 export function renderAccountUI() {
     if (AUTH_SESSION) {
         if (accountLabel) accountLabel.innerText = AUTH_SESSION.username;
-        if (accountSublabel) accountSublabel.innerText = `Conectado (${tipoDeCuenta(AUTH_SESSION)})`;
+        // Solo el tipo: "Conectado (sin licencia)" no entra en la barra lateral
+        // y quedaba recortado. Que haya nombre y botón de salir ya dice que hay
+        // sesión abierta.
+        if (accountSublabel) accountSublabel.innerText = capitalizar(tipoDeCuenta(AUTH_SESSION));
         if (accountAvatar) accountAvatar.innerText = avatarDeCuenta(AUTH_SESSION);
         logoutBtn?.classList.remove('hidden');
     } else {
-- 
2.55.0

