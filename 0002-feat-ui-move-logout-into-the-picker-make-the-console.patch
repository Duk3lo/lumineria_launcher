diff --git a/src/js/ui/console.js b/src/js/ui/console.js
index 9c46c39..5de0b23 100644
--- a/src/js/ui/console.js
+++ b/src/js/ui/console.js
@@ -4,10 +4,19 @@ const panel = document.getElementById('console-panel');
 const output = document.getElementById('console-output');
 const MAX_LINES = 2000;
 
+// Geometría de la consola. Va en localStorage y no en settings.json porque es
+// preferencia de ventana, no configuración del launcher, y se escribe seguido.
+const GEOMETRY_KEY = 'lumineria.console.geometry';
+const DEFAULT_SIZE = { width: 480, height: 320 };
+const MARGIN = 16;
+// Cuánto del panel hay que dejar siempre visible para poder volver a agarrarlo.
+const MIN_VISIBLE = 80;
+
 let lines = [];
 let pending = [];
 let flushQueued = false;
 let isPanelOpen = false;
+let saveQueued = false;
 
 function queueFlush() {
     if (flushQueued) return;
@@ -35,11 +44,143 @@ function appendLine(text) {
     queueFlush();
 }
 
+/* ---------------------- Posición y tamaño persistentes --------------------- */
+
+function readGeometry() {
+    try {
+        const raw = localStorage.getItem(GEOMETRY_KEY);
+        if (!raw) return null;
+        const g = JSON.parse(raw);
+        const numeros = [g.left, g.top, g.width, g.height];
+        if (!numeros.every(n => typeof n === 'number' && Number.isFinite(n))) return null;
+        return g;
+    } catch (e) {
+        // localStorage lleno o JSON corrupto: se arranca con la posición por defecto.
+        console.warn('No se pudo leer la geometría de la consola:', e);
+        return null;
+    }
+}
+
+function saveGeometry() {
+    const g = {
+        left: panel.offsetLeft,
+        top: panel.offsetTop,
+        width: panel.offsetWidth,
+        height: panel.offsetHeight,
+    };
+    try {
+        localStorage.setItem(GEOMETRY_KEY, JSON.stringify(g));
+    } catch (e) {
+        console.warn('No se pudo guardar la geometría de la consola:', e);
+    }
+}
+
+// Las escrituras se agrupan por frame: el ResizeObserver dispara en cada píxel
+// que se arrastra el agarre.
+function queueSaveGeometry() {
+    if (saveQueued) return;
+    saveQueued = true;
+    requestAnimationFrame(() => {
+        saveQueued = false;
+        saveGeometry();
+    });
+}
+
+// Mantiene el panel dentro de la ventana. Hace falta al abrirlo (la ventana pudo
+// achicarse o cambiar de monitor desde la última vez) y al redimensionarla.
+function clampIntoViewport() {
+    const maxWidth = Math.max(200, window.innerWidth - MARGIN * 2);
+    const maxHeight = Math.max(120, window.innerHeight - MARGIN * 2);
+    const width = Math.min(panel.offsetWidth, maxWidth);
+    const height = Math.min(panel.offsetHeight, maxHeight);
+    panel.style.width = `${width}px`;
+    panel.style.height = `${height}px`;
+
+    const maxLeft = window.innerWidth - MIN_VISIBLE;
+    const maxTop = window.innerHeight - MIN_VISIBLE;
+    const left = Math.min(Math.max(panel.offsetLeft, MIN_VISIBLE - width), maxLeft);
+    const top = Math.min(Math.max(panel.offsetTop, 0), maxTop);
+    panel.style.left = `${left}px`;
+    panel.style.top = `${top}px`;
+}
+
+function applyStoredGeometry() {
+    const g = readGeometry();
+    if (g) {
+        panel.style.width = `${g.width}px`;
+        panel.style.height = `${g.height}px`;
+        panel.style.left = `${g.left}px`;
+        panel.style.top = `${g.top}px`;
+    } else {
+        // Por defecto, abajo a la derecha: donde estaba anclada antes.
+        panel.style.width = `${DEFAULT_SIZE.width}px`;
+        panel.style.height = `${DEFAULT_SIZE.height}px`;
+        panel.style.left = `${window.innerWidth - DEFAULT_SIZE.width - MARGIN}px`;
+        panel.style.top = `${window.innerHeight - DEFAULT_SIZE.height - MARGIN}px`;
+    }
+    // Acá no se puede acotar todavía: el panel arranca oculto y un display:none
+    // mide 0 en todo. El ajuste se hace al abrirlo.
+}
+
+function initDragAndResize() {
+    const header = panel.querySelector('.console-header');
+
+    header?.addEventListener('pointerdown', (e) => {
+        // Limpiar y cerrar viven en el encabezado: no deben arrastrar.
+        if (e.target.closest('button')) return;
+        if (e.button !== 0) return;
+
+        const startX = e.clientX;
+        const startY = e.clientY;
+        const startLeft = panel.offsetLeft;
+        const startTop = panel.offsetTop;
+        panel.classList.add('dragging');
+        // Con capture el arrastre sigue funcionando aunque el puntero salga del
+        // encabezado, y no hace falta escuchar en window.
+        header.setPointerCapture(e.pointerId);
+
+        const onMove = (ev) => {
+            panel.style.left = `${startLeft + ev.clientX - startX}px`;
+            panel.style.top = `${startTop + ev.clientY - startY}px`;
+        };
+        const onUp = () => {
+            header.removeEventListener('pointermove', onMove);
+            header.removeEventListener('pointerup', onUp);
+            header.removeEventListener('pointercancel', onUp);
+            panel.classList.remove('dragging');
+            clampIntoViewport();
+            saveGeometry();
+        };
+
+        header.addEventListener('pointermove', onMove);
+        header.addEventListener('pointerup', onUp);
+        header.addEventListener('pointercancel', onUp);
+    });
+
+    // El agarre de resize es nativo (CSS resize: both), así que no hay eventos
+    // propios: se observa el tamaño y se guarda.
+    new ResizeObserver(() => {
+        if (isPanelOpen) queueSaveGeometry();
+    }).observe(panel);
+
+    window.addEventListener('resize', () => {
+        if (!isPanelOpen) return;
+        clampIntoViewport();
+        queueSaveGeometry();
+    });
+}
+
 export function initConsole() {
+    applyStoredGeometry();
+    initDragAndResize();
+
     document.getElementById('console-toggle-btn')?.addEventListener('click', () => {
         panel.classList.toggle('hidden');
         isPanelOpen = !panel.classList.contains('hidden');
         if (isPanelOpen) {
+            // Recién visible se puede medir, así que es el momento de encajarlo
+            // en la ventana por si cambió de tamaño desde la última sesión.
+            clampIntoViewport();
             output.textContent = lines.join('\n') + (lines.length ? '\n' : '');
             output.scrollTop = output.scrollHeight;
         }
